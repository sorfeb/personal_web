  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "node scripts/copy-emulators.mjs",
    "build": "prisma generate && next build",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
