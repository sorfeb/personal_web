    "db:migrate:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:css:fix": "stylelint \"src/**/*.css\" --cache --cache-location node_modules/.cache/stylelint/ --fix",
    "lint:useeffect": "tsx scripts/lint-useeffect.ts",
    "enrich:lastfm": "tsx --env-file=.env.local scripts/enrich-lastfm.ts",
    "compile": "tsc",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
