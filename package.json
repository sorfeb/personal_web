    "js-dos": "8.4.1",
    "lucide-react": "^0.561.0",
    "next": "^15.5.7",
    "next-cloudinary": "^6.16.0",
    "next-sitemap": "^4.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-shepherd": "^6.1.7",
