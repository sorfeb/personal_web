// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] // Required for Neon adapter
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/**
* User model to match StackAuth user structure
*
* @model User
* Represents a user in the system, structured to match the StackAuth user schema.
* This model is used for authentication and user profile management.
*/
model User {
  id               String   @id @default(cuid())
  name             String?
  image            String?
  email            String?  @unique
  stackAuthId      String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relations
  messages         Message[]
}

// Chatroom Message model
model Message {
  id           String   @id @default(cuid())
  text         String
  createdAt    DateTime @default(now())
  
  // Author relation
  author       User     @relation(fields: [authorId], references: [id])
  authorId     String
}
