{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(python:*)",
      "mcp__playwright",
      "mcp__context7",
      "WebSearch"
    ],
    "deny": [
      "Read(**/*.env)",
      "Read(**/*.env.*)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/*.env)",
      "Edit(**/*.env.*)",
      "Write(configs/**)",
      "Write(**/*.env)",
      "Write(**/*.env.*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
