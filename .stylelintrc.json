{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-css-modules"
  ],
  "plugins": [
    "stylelint-declaration-strict-value",
    "stylelint-value-no-unknown-custom-properties"
  ],
  "reportNeedlessDisables": true,
  "rules": {
    "selector-class-pattern": null,
    "keyframes-name-pattern": null,
    "no-descending-specificity": null,

    "color-no-hex": [true, {
      "severity": "warning",
      "message": "Use a color token: var(--color-*) from design-tokens.css"
    }],
    "color-named": ["never", {
      "severity": "warning",
      "message": "Use a color token: var(--color-*) from design-tokens.css"
    }],
    "function-disallowed-list": [
      ["rgb", "rgba", "hsl", "hsla", "hwb"],
      {
        "severity": "warning",
        "message": "Raw color functions belong in design-tokens.css only — use var(--color-*)"
      }
    ],

    "scale-unlimited/declaration-strict-value": [
      ["/color$/", "fill", "stroke", "border-radius"],
      {
        "ignoreValues": ["currentColor", "transparent", "inherit", "initial", "unset", "none", "0", "50%", "100%"],
        "expandShorthand": true,
        "severity": "warning",
        "message": "Use a design token: ${property} must be var(--*)"
      }
    ],

    "csstools/value-no-unknown-custom-properties": [true, {
      "importFrom": ["src/app/design-tokens.css"],
      "severity": "warning"
    }]
  },
  "overrides": [
    {
      "files": ["src/app/design-tokens.css", "src/app/globals.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "scale-unlimited/declaration-strict-value": null
      }
    }
  ]
}
